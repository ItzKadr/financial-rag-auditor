# Copy to .env (git-ignored) and fill in ONE OR MORE keys. Without any key the pipeline
# runs fully offline with the deterministic rule-based extractor.

# --- OpenAI (Structured Outputs via client.chat.completions.parse) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_RESPONSE_MODE=parse            # parse | json_schema | json_object

# --- DeepSeek (OpenAI-compatible, JSON mode) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_RESPONSE_MODE=json_object

# --- Groq (OpenAI-compatible, JSON mode) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_RESPONSE_MODE=json_object
